{
  "name": "locklens-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/bundle.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/password.test.mjs tests/strength.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1"
  }
}
